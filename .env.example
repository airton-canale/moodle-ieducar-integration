# ===== i-Educar =====
# No compose unificado: http://nginx. Dev local (sem compose): http://host.docker.internal:80
IEDUCAR_BASE_URL=http://nginx
# Gerada em i-Educar: tabela legacy.apis + legacy.apis_access_key
IEDUCAR_ACCESS_KEY=
# http = cliente real; fake = cliente em memoria para desenvolvimento/testes
IEDUCAR_CLIENTE=http
IEDUCAR_TIMEOUT_SEG=15

# ===== Moodle =====
# No compose unificado: http://moodle:8080. Dev local: http://host.docker.internal:8081
MOODLE_BASE_URL=http://moodle:8080
# Gerado em Site administration -> Server -> Web services -> Manage tokens
MOODLE_TOKEN=
MOODLE_CLIENTE=http
MOODLE_TIMEOUT_SEG=15

# IDs de papeis no Moodle (padrao: 5=student, 3=editingteacher)
MOODLE_ROLE_ALUNO=5
MOODLE_ROLE_PROFESSOR=3

# ===== Dominio =====
# Filtros padrao usados pelos endpoints quando nao recebem query params
# Descomente e preencha para fixar uma escola padrao
#ESCOLA_ID_PADRAO=1
ANO_PADRAO=2025

# Prefixos usados em idnumber para correlacionar os dois sistemas
PREFIXO_IDNUMBER_TURMA=ieducar-turma-
PREFIXO_IDNUMBER_PESSOA=ieducar-pessoa-

# Dominio para emails sinteticos quando a pessoa nao tem email cadastrado
DOMINIO_EMAIL_SINTETICO=ieducar.local

# ===== Banco (uso interno da integracao) =====
DATABASE_URL=postgresql+psycopg://integracao:integracao@banco:5432/integracao

# ===== Agendador =====
AGENDADOR_HABILITADO=true
AGENDADOR_INTERVALO_MIN=15
